# ----------------------------------------------------
# Project I.R.I.S. 環境変数サンプル
# このファイルをコピーして .env を作成してください。
# .env は .gitignore により Git 管理から除外されます。
# ----------------------------------------------------

# SurrealDB 接続設定
SURREAL_URL=ws://surrealdb:8000
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=iris
SURREAL_DB=memory_graph

# Ollama 接続設定（ローカルLLM）
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma3n

# Tavily API キー（自律リサーチに使用）
TAVILY_API_KEY=your_tavily_api_key_here

# Axum サーバー設定
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
